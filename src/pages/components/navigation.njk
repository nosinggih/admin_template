---
layout: layouts/dashboard.njk
title: Tabs, Accordion, Breadcrumb & Pagination
breadcrumb:
  - { label: "Home", url: "/" }
  - { label: "Komponen UI", url: "/components/" }
  - { label: "Navigation" }
---
<div class="row row-cards g-3">
  <!-- Tabs Component -->
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" id="myTab" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home-tab-pane" type="button" role="tab">Ringkasan</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-tab-pane" type="button" role="tab">Detail</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact-tab-pane" type="button" role="tab">Riwayat</button>
          </li>
        </ul>
      </div>
      <div class="card-body">
        <div class="tab-content" id="myTabContent">
          <div class="tab-pane fade show active" id="home-tab-pane" role="tabpanel" tabindex="0">
            <h6>Konten Tab Ringkasan</h6>
            <p class="small text-muted mb-0">Menampilkan rangkuman statistik dan informasi umum secara cepat.</p>
          </div>
          <div class="tab-pane fade" id="profile-tab-pane" role="tabpanel" tabindex="0">
            <h6>Konten Tab Detail</h6>
            <p class="small text-muted mb-0">Rincian parameter teknis dan konfigurasi lengkap pengguna.</p>
          </div>
          <div class="tab-pane fade" id="contact-tab-pane" role="tabpanel" tabindex="0">
            <h6>Konten Tab Riwayat</h6>
            <p class="small text-muted mb-0">Daftar log aktivitas dan jejak perubahan sistem terbaru.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Accordion Component -->
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">
        <h5 class="card-title m-0">Accordion (Pertanyaan Umum)</h5>
      </div>
      <div class="card-body">
        <div class="accordion" id="accordionExample">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true">
                Bagaimana cara mengubah kata sandi?
              </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#accordionExample">
              <div class="accordion-body small text-muted">
                Buka menu Pengaturan -> Keamanan -> Ubah Kata Sandi untuk memperbarui kredensial Anda.
              </div>
            </div>
          </div>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false">
                Apakah template ini mendukung mode gelap?
              </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
              <div class="accordion-body small text-muted">
                Ya! Template ini menggunakan atribut bawaan Bootstrap 5.3 (`data-bs-theme="dark"`) dan tersimpan otomatis di localStorage.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pagination Component -->
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h5 class="card-title m-0">Pagination</h5>
      </div>
      <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span class="small text-muted">Menampilkan 1 - 10 dari 120 data</span>
        <nav aria-label="Page navigation example">
          <ul class="pagination pagination-sm mb-0">
            <li class="page-item disabled"><a class="page-link" href="#">Sebelumnya</a></li>
            <li class="page-item active"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item"><a class="page-link" href="#">Berikutnya</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</div>
