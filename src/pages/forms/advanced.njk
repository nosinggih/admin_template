---
layout: layouts/dashboard.njk
title: Form Input Lanjutan
breadcrumb:
  - { label: "Home", url: "/" }
  - { label: "Form & Input", url: "/forms/inputs/" }
  - { label: "Form Lanjutan" }
---
<!-- Load Flatpickr & Tom Select CSS secara inline di halaman -->
<link rel="stylesheet" href="/assets/vendor/flatpickr.min.css">
<link rel="stylesheet" href="/assets/vendor/tom-select.bootstrap5.min.css">

<!-- Load Vendor Scripts sebelum modul JS app.js menginisialisasinya -->
<script src="/assets/vendor/flatpickr.min.js"></script>
<script src="/assets/vendor/tom-select.complete.min.js"></script>

<div class="container-xl">
  <div class="page-header d-print-none">
    <div class="row align-items-center">
      <div class="col">
        <h2 class="page-title">Form Input Lanjutan</h2>
        <p class="text-muted small">Showcase komponen penyeleksi tanggal (Date Picker) dan menu dropdown dengan pencarian autocomplete (Tom Select) berbasis Vanilla JS.</p>
      </div>
    </div>
  </div>

  <div class="page-body">
    <div class="row row-cards g-3">
      
      <!-- Date & Time Pickers -->
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-header">
            <h5 class="card-title m-0">Date & Time Picker (Flatpickr)</h5>
          </div>
          <div class="card-body">
            <div class="mb-4">
              <label class="form-label font-semibold">Pilih Tanggal Tunggal</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted">{% icon "calendar", { class: "icon-sm" } %}</span>
                <input type="text" class="form-control" data-at-datepicker placeholder="Pilih tanggal..." value="2026-07-24">
              </div>
              <div class="form-text">Menggunakan picker kalender lokal yang responsif.</div>
            </div>

            <div class="mb-4">
              <label class="form-label font-semibold">Pilih Rentang Tanggal (Date Range)</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted">{% icon "calendar-event", { class: "icon-sm" } %}</span>
                <input type="text" class="form-control" data-at-daterangepicker placeholder="Pilih rentang tanggal..." value="2026-07-24 ke 2026-07-31">
              </div>
              <div class="form-text">Memilih tanggal mulai dan tanggal berakhir dalam satu input.</div>
            </div>

            <div class="mb-3">
              <label class="form-label font-semibold">Tanggal & Waktu Sekaligus</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted">{% icon "clock", { class: "icon-sm" } %}</span>
                <input type="text" class="form-control" data-at-datetimepicker placeholder="Pilih tanggal & jam..." value="2026-07-24 15:00">
              </div>
              <div class="form-text">Mendukung format jam 24-jam dengan pemilih menit.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Advanced Selects (Tom Select) -->
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-header">
            <h5 class="card-title m-0">Select Autocomplete & Tags (Tom Select)</h5>
          </div>
          <div class="card-body">
            <!-- Autocomplete Select -->
            <div class="mb-4">
              <label class="form-label font-semibold">Pilih Negara (Pencarian Autocomplete)</label>
              <select id="select-country" data-at-select-search placeholder="Cari negara..." class="form-select">
                <option value="">Cari negara...</option>
                <option value="ID" selected>Indonesia</option>
                <option value="MY">Malaysia</option>
                <option value="SG">Singapura</option>
                <option value="TH">Thailand</option>
                <option value="PH">Filipina</option>
                <option value="VN">Vietnam</option>
                <option value="JP">Jepang</option>
                <option value="KR">Korea Selatan</option>
                <option value="US">Amerika Serikat</option>
                <option value="GB">Inggris Raya</option>
                <option value="DE">Jerman</option>
              </select>
              <div class="form-text">Mencari item dengan cepat pada dropdown yang memiliki opsi banyak.</div>
            </div>

            <!-- Multi-Select Tags -->
            <div class="mb-3">
              <label class="form-label font-semibold">Keahlian / Tags (Multi-Select & Hapus Tag)</label>
              <select id="select-tags" data-at-select-tags multiple placeholder="Tambahkan keahlian..." class="form-select">
                <option value="html" selected>HTML5</option>
                <option value="css" selected>CSS3</option>
                <option value="js" selected>JavaScript</option>
                <option value="bootstrap">Bootstrap 5</option>
                <option value="sass">Dart Sass</option>
                <option value="eleventy">Eleventy</option>
                <option value="esbuild">esbuild</option>
                <option value="git">Git Version Control</option>
              </select>
              <div class="form-text">Mendukung pembuatan tag dinamis dan tombol hapus tag terintegrasi.</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
