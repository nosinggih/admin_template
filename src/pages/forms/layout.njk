---
layout: layouts/dashboard.njk
title: Form Layout & Stepper Wizard
breadcrumb:
  - { label: "Home", url: "/" }
  - { label: "Form & Input", url: "/forms/" }
  - { label: "Form Layout" }
---
<div class="row row-cards g-3">
  <!-- Horizontal Form -->
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h5 class="card-title m-0">Form Layout Horizontal</h5>
      </div>
      <div class="card-body">
        <form>
          <div class="row mb-3">
            <label for="inputEmail3" class="col-sm-3 col-form-label font-semibold">Email Pengguna</label>
            <div class="col-sm-9">
              <input type="email" class="form-control" id="inputEmail3" placeholder="email@domain.com">
            </div>
          </div>
          <div class="row mb-3">
            <label for="inputPassword3" class="col-sm-3 col-form-label font-semibold">Kata Sandi</label>
            <div class="col-sm-9">
              <input type="password" class="form-control" id="inputPassword3">
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label font-semibold">Peran Akses</label>
            <div class="col-sm-9">
              <select class="form-select">
                <option value="1">Administrator</option>
                <option value="2">Operator</option>
              </select>
            </div>
          </div>
          <div class="row">
            <div class="col-sm-9 offset-sm-3">
              <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
              <button type="button" class="btn btn-outline-secondary ms-2">Batal</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Wizard Stepper Sederhana -->
  <div class="col-12">
    <div class="card">
      <div class="card-header border-bottom-0 pb-0">
        <!-- Steps Navigation -->
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-3">
          <div class="d-flex align-items-center text-primary">
            <span class="badge bg-primary rounded-circle me-2">1</span>
            <span class="fw-bold small">1. Informasi Akun</span>
          </div>
          <div class="d-flex align-items-center text-muted">
            <span class="badge bg-secondary rounded-circle me-2">2</span>
            <span class="small">2. Profil Pribadi</span>
          </div>
          <div class="d-flex align-items-center text-muted">
            <span class="badge bg-secondary rounded-circle me-2">3</span>
            <span class="small">3. Konfirmasi</span>
          </div>
        </div>
      </div>
      <div class="card-body">
        <h6 class="fw-bold mb-3">Langkah 1: Membuat Kredensial Akun</h6>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Username</label>
            <input type="text" class="form-control" placeholder="Pilih username unik">
          </div>
          <div class="col-md-6">
            <label class="form-label">Alamat Email</label>
            <input type="email" class="form-control" placeholder="email@domain.com">
          </div>
          <div class="col-md-6">
            <label class="form-label">Password</label>
            <input type="password" class="form-control">
          </div>
          <div class="col-md-6">
            <label class="form-label">Ulangi Password</label>
            <input type="password" class="form-control">
          </div>
        </div>
      </div>
      <div class="card-footer d-flex justify-content-between">
        <button class="btn btn-light" disabled>Sebelumnya</button>
        <button class="btn btn-primary">Lanjut Langkah 2 {% icon "chevron-right" %}</button>
      </div>
    </div>
  </div>
</div>
