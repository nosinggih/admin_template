---
layout: layouts/dashboard.njk
title: Tabel Interaktif (Datatable Vanilla JS)
breadcrumb:
  - { label: "Home", url: "/" }
  - { label: "Tampilan Data", url: "/tables/" }
  - { label: "Tabel Interaktif" }
---
<div class="card" data-at-datatable data-page-size="4">
  <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h5 class="card-title m-0">Tabel Produk Interaktif</h5>
    <div style="max-width: 250px; width: 100%;">
      <div class="input-group input-group-sm">
        <span class="input-group-text bg-transparent border-end-0">{% icon "search" %}</span>
        <input type="search" class="form-control border-start-0 at-table-search" placeholder="Cari produk...">
      </div>
    </div>
  </div>
  <div class="table-responsive">
    <table class="table table-hover card-table">
      <thead>
        <tr>
          <th data-sort>Nama Produk {% icon "arrows-sort" %}</th>
          <th data-sort>Kategori {% icon "arrows-sort" %}</th>
          <th data-sort>Harga {% icon "arrows-sort" %}</th>
          <th data-sort>Stok {% icon "arrows-sort" %}</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="fw-semibold">Laptop Pro 15"</td>
          <td>Elektronik</td>
          <td>Rp 18.500.000</td>
          <td>42</td>
          <td><span class="badge bg-success">Tersedia</span></td>
        </tr>
        <tr>
          <td class="fw-semibold">Wireless Mouse</td>
          <td>Aksesori</td>
          <td>Rp 250.000</td>
          <td>150</td>
          <td><span class="badge bg-success">Tersedia</span></td>
        </tr>
        <tr>
          <td class="fw-semibold">Mechanical Keyboard</td>
          <td>Aksesori</td>
          <td>Rp 850.000</td>
          <td>18</td>
          <td><span class="badge bg-warning text-dark">Stok Menipis</span></td>
        </tr>
        <tr>
          <td class="fw-semibold">Monitor UltraWide 34"</td>
          <td>Elektronik</td>
          <td>Rp 7.200.000</td>
          <td>5</td>
          <td><span class="badge bg-warning text-dark">Stok Menipis</span></td>
        </tr>
        <tr>
          <td class="fw-semibold">USB-C Docking Station</td>
          <td>Aksesori</td>
          <td>Rp 650.000</td>
          <td>0</td>
          <td><span class="badge bg-danger">Habis</span></td>
        </tr>
        <tr>
          <td class="fw-semibold">Headset Gaming Noise-Cancel</td>
          <td>Audio</td>
          <td>Rp 1.100.000</td>
          <td>64</td>
          <td><span class="badge bg-success">Tersedia</span></td>
        </tr>
        <tr>
          <td class="fw-semibold">Webcam HD 1080p</td>
          <td>Elektronik</td>
          <td>Rp 450.000</td>
          <td>80</td>
          <td><span class="badge bg-success">Tersedia</span></td>
        </tr>
      </tbody>
    </table>
  </div>
  <div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2">
    <span class="small text-muted">Klik header kolom untuk mengurutkan data</span>
    <div class="at-table-pagination"></div>
  </div>
</div>
